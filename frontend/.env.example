# Copy to .env (not committed) and set once the backend is deployed.
# Expo (SDK 49+) loads EXPO_PUBLIC_* vars into process.env automatically —
# no extra config needed. Leave unset for local dev (auto-detects your LAN IP).
EXPO_PUBLIC_API_BASE_URL=https://volo-api.onrender.com

# Firebase web config (Project settings → General → Your apps → Web app) —
# must be the SAME Firebase project as the backend's FIREBASE_PROJECT_ID, and
# Phone sign-in must be enabled under Authentication → Sign-in method.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
