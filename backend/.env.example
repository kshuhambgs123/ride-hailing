PORT=5000
NODE_ENV=development
# backend/src/data-source.ts reads these discrete vars, not a DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=volo
JWT_SECRET=supersecretkey
FIREBASE_PROJECT_ID=blablaride-firebase
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@blablaride.iam.gserviceaccount.com

# Required in production: enables the Socket.io Redis adapter (multi-instance
# chat/live-tracking) and driver geolocation lookups.
REDIS_URL=redis://localhost:6379

# Required in production: without AWS_S3_BUCKET, ID-proof uploads fall back to
# local disk, which does not survive redeploys or work with >1 backend instance.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe (live mode keys for production; test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe Dashboard webhook endpoint (or `stripe listen` in dev).
# Required: without it, card payments are never confirmed server-side and
# rides stay stuck at paymentStatus "pending" forever regardless of whether
# the card actually charged.
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay (Dashboard > Settings > API Keys). Payment Links API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > the secret you set when adding the
# /api/webhooks/razorpay endpoint, subscribed to payment_link.paid,
# payment_link.cancelled, payment_link.expired.
RAZORPAY_WEBHOOK_SECRET=

# PayPal (developer.paypal.com > Apps & Credentials). Sandbox credentials for
# dev; live credentials switch automatically when NODE_ENV=production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# developer.paypal.com > Apps & Credentials > your app > Webhooks > the
# webhook you add for /api/webhooks/paypal, subscribed to
# CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED.
PAYPAL_WEBHOOK_ID=
